# Заполни своими значениями и сохрани рядом с docker-compose.yml как .env
DOMAIN=
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=https://
POSTGRES_PASSWORD=

# Публичный Tranzy OpenData: API-ключ и выбранная по актуальной документации точка данных.
# Не вставляй ключ в браузер; он используется только backend.
TRANZY_API_KEY=
TRANZY_VEHICLES_URL=https://api.tranzy.ai/v1/opendata/vehicles
# Опционально: ID агентства (если не задан, адаптер определяет автоматически через /v1/opendata/agency)
TRANZY_AGENCY_ID=
TRANZY_REFRESH_MINUTES=5

TZ=Europe/Chisinau
