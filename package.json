{
  "name": "usm-life-miniapp",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w @usm/web",
    "build": "npm run build -w @usm/web",
    "typecheck": "npm run typecheck -w @usm/shared && npm run typecheck -w @usm/web && npm run typecheck -w @usm/worker",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:cloudflare": "npm run build -w @usm/web && npm run deploy -w @usm/worker",
    "migrate:cloudflare": "npm run migrate -w @usm/worker",
    "migrate:turso": "npm run migrate:turso -w @usm/worker",
    "import:turso": "npm run import:turso -w @usm/worker"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "workerd@1.20261006.1": true
  }
}
